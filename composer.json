{
  "name": "ernestdefoe/seo",
  "description": "Adds SEO tags for your Flarum forum",
  "type": "flarum-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "ernestdefoe"
    }
  ],
  "homepage": "https://github.com/ernestdefoe/seo",
  "support": {
    "issues": "https://github.com/ernestdefoe/seo/issues",
    "source": "https://github.com/ernestdefoe/seo"
  },
  "autoload": {
    "psr-4": {
      "V17Development\\FlarumSeo\\": "src/"
    }
  },
  "require": {
    "php": "^8.1",
    "flarum/core": "^2.0",
    "ext-json": "*"
  },
  "require-dev": {
    "flarum/tags": "^2.0",
    "fof/pages": "^2.0",
    "fof/best-answer": "^2.0",
    "flarum/phpstan": "^2.0"
  },
  "conflict": {
    "zerosonesfun/elint": "*",
    "franzl/flarum-open-links-in-new-tab": "*"
  },
  "suggest": {
    "fof/sitemap": "Allows you to generate powerful sitemap.xml files"
  },
  "extra": {
    "flarum-extension": {
      "title": "Ernestdefoe SEO",
      "category": "feature",
      "optional-dependencies": [
        "flarum/tags",
        "ernestdefoe/og-image"
      ],
      "icon": {
        "name": "fas fa-check",
        "backgroundColor": "#0072ff",
        "color": "#ffffff"
      }
    }
  },
  "scripts": {
    "analyse:phpstan": "phpstan analyse",
    "clear-cache:phpstan": "phpstan clear-result-cache"
  }
}
